#!/bin/sh

run_checks() {
    repository_root=$(git rev-parse --show-toplevel)
    if [ -z "${repository_root}" ]; then
        echo "pre-commit: repository root not found." >&2
        return 1
    fi

    if ! cd "${repository_root}"; then
        echo "pre-commit: failed to enter repository root: ${repository_root}" >&2
        return 1
    fi

    echo "pre-commit: running make check"
    if ! make check; then
        echo "pre-commit: make check failed." >&2
        return 1
    fi

    echo "pre-commit: make check completed."
    return 0
}

main() {
    run_checks
}

main
