[statedef -2]

[state ]
type=varset
trigger1=!ishelper
trigger1=!var(0)
var(0)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=!ishelper
var(0)=1
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
trigger1=time=0
var(1)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=!ishelper
var(1)=1
ignorehitpause=1

[state ]
type=displaytoclipboard
trigger1=!ishelper
text="private-gametime: %d\nprivate-time: %d"
params=var(0),var(1)
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
trigger1=!ishelper(99001)
value=5150
ignorehitpause=1

[state ]
type=posset
trigger1=ishelper(99001)
x=root,pos x
y=root,pos y-61+sin(root,var(0)*0.11)*1
ignorehitpause=1

[state ]
type=trans
trigger1=!ishelper
trigger2=ishelper(99001)
trans=addalpha
alpha=256,55
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
value=99000
ignorehitpause=1

[statedef -3]

[state ]
type=posset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=command!="holdup"
y=0
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=command!="holdup"
y=0
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=command="holdup"
y=-const(velocity.walk.fwd.x)
ignorehitpause=1

[state ]
type=veladd
trigger1=!ishelper
trigger1=command!="holdup"
trigger1=pos y<0
y=const(movement.yaccel)
ignorehitpause=1

[state ]
type=veladd
trigger1=!ishelper
trigger1=pos y<=-400
y=const(movement.yaccel)
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y<0
statetype=a
physics=n
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=command="holddown"
statetype=c
physics=c
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=command!="holddown"
statetype=s
physics=s
ignorehitpause=1

[state ]
type=helper
trigger1=!ishelper
trigger1=!numhelper(99001)
name="the_head"
id=99001
anim=99001
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

[state ]
type=assertspecial
trigger1=root,stateno=[100,107]
flag=invisible

[state ]
type=afterimage
trigger1=!ishelper
trigger1=!var(10)
trigger1=var(10):=1||1
trigger2=ishelper(99001)
trigger2=!var(10)
trigger2=var(10):=1||1
trigger3=ishelper(99001)||!ishelper
trigger3=!(root,var(0)%600)
time=-1
length=64
trans=add
palcolor=128
palbright=15,15,45
palcontrast=88,88,188
palpostbright=0,0,0
paladd=0,0,0
palmul=1.1,1.1,1.1
ignorehitpase=1
