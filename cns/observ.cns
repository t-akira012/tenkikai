[statedef -2]

;; 自動運用フラグ 利用したい場合は trigger1=1 に指定

[state ]
type=varset
triggerall=!ishelper
trigger1=0
trigger2=palno=[6,12]
var(2)=var(2)|-2147483648
ignorehitpause=1

;; 常駐Helper自動最大ライフ

[state ]
type=lifeset
trigger1=ishelper
value=const(data.life)
ignorehitpause=1

[state ]
type=lifeadd
trigger1=!ishelper
trigger1=numhelper(99004)
trigger1=helper(99004),var(11)>0
value=-ifelse(life<=lifemax/4,ifelse((helper(99004),var(11))>1,(helper(99004),var(11))/2,1),(helper(99004),var(11)))
kill=1
absolute=1
ignorehitpause=1

[state ]
type=lifeadd
trigger1=!ishelper
trigger1=alive
trigger1=life<lifemax
trigger1=numhelper(99004)
trigger1=helper(99004),var(11)=0
value=1
kill=0
absolute=1
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
trigger1=!ishelper(99003)
trigger1=!ishelper(99002)
trigger1=!ishelper(99001)
trigger1=!ishelper(99004)
value=5150
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
value=99000
ignorehitpause=1

;; 変数更新とデバッグ表示

;; AngleDraw無効化時の残留傾斜解除

[state ]
type=varset
trigger1=!ishelper
var(5)=0
ignorehitpause=1

[state ]
type=angledraw
trigger1=!ishelper
value=0
scale=1,1
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
trigger1=!var(0)
var(0)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=!ishelper
var(0)=1
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
fvar(0)=asin(sin(var(0)*pi/48))*2/pi
ignorehitpause=1

[state ]
type=displaytoclipboard
trigger1=!ishelper
text="private-time: %d\npos y: %f"
params=var(1),pos y
ignorehitpause=1

[statedef -3]

;; 浮遊移動と状態変更

[state ]
type=posset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=(var(2)&4)=0
y=0
ignorehitpause=1

[state ]
type=posadd
trigger1=!ishelper
trigger1=(var(2)&4)!=0
y=-6
ignorehitpause=1

[state ]
type=posadd
trigger1=!ishelper
trigger1=(var(2)&4)!=0
trigger1=pos y<-90
y=6*((-pos y-90)/90)
ignorehitpause=1

[state ]
type=posadd
trigger1=!ishelper
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)!=0
trigger1=pos y<0
y=6
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=(var(2)&4)=0
y=0
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=(var(2)&4)!=0
y=0
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=(var(2)&8)!=0
y=0
ignorehitpause=1

[state ]
type=veladd
trigger1=!ishelper
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)=0
trigger1=pos y<-40
trigger1=vel y<1.0
y=const(movement.yaccel)*0.1
ignorehitpause=1

[state ]
type=veladd
trigger1=!ishelper
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)=0
trigger1=pos y<-90
trigger1=vel y<1.0
y=const(movement.yaccel)*0.1*((-pos y-90)/90)
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=(var(2)&4)=0
trigger1=pos y>=-40
trigger1=pos y<0
y=0
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=(var(2)&4)!=0
statetype=a
physics=n
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y<0
statetype=a
physics=n
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=(var(2)&8)!=0
statetype=c
physics=c
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=(var(2)&8)=0
trigger1=(var(2)&4)=0
statetype=s
physics=s
ignorehitpause=1

;; 浮遊表示

[state ]
type=offset
trigger1=!ishelper
trigger1=movetype!=h
trigger1=statetype!=c
trigger1=(stateno=0)||(stateno=20)||(stateno=21)||(stateno=[60,61])||(statetype=a)
y=8*(fvar(0)*(0.9+0.1*abs(fvar(0)))+1.6*fvar(0)*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0)))+2
ignorehitpause=1

[state ]
type=offset
trigger1=!ishelper
trigger1=(movetype=h)||(statetype=c)
trigger2=!ishelper
trigger2=(stateno!=0)&&(stateno!=20)&&(stateno!=21)&&(stateno!=[60,61])&&(statetype!=a)
y=0
ignorehitpause=1

;; Controller・頭部ヘルパー生成

[state ]
type=helper
trigger1=!ishelper
trigger1=!numhelper(99004)
name="the_controller"
id=99004
stateno=99004000
anim=99004
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

[state ]
type=helper
trigger1=!ishelper
trigger1=!numhelper(99001)
name="the_head"
id=99001
stateno=99001000
anim=99001
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

[state ]
type=helper
trigger1=!ishelper
trigger1=!numhelper(99003)
trigger1=numhelper(99001)
name="the_head_aura"
id=99003
stateno=99003000
anim=99001
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

;; オーラヘルパー生成

[state ]
type=helper
trigger1=!ishelper
trigger1=!numhelper(99002)
name="the_aura"
id=99002
stateno=99002000
anim=0
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

;; 本体透過

[state ]
type=trans
trigger1=!ishelper
trans=addalpha
alpha=128,128
ignorehitpause=1

;; 本体残像

[state ]
type=afterimage
triggerall=stateno!=301
trigger1=!ishelper
trigger1=!var(10)
trigger1=var(10):=1||1
trigger3=!ishelper
trigger3=!(var(0)%600)
time=-1
length=48
trans=add
palcolor=128
palbright=15,15,45
palcontrast=88,88,188
palpostbright=0,0,0
paladd=0,0,0
palmul=0.6,0.6,0.8
ignorehitpause=1
