[statedef -2]

;; 自動運用フラグ 利用したい場合は trigger1=1 に指定

[state ]
type=varset
triggerall=!ishelper
trigger1=0
trigger2=palno=[6,12]
var(2)=var(2)|-2147483648
ignorehitpause=1

;; 常駐Helper自動最大ライフ

[state ]
type=lifeset
trigger1=ishelper
value=const(data.life)
ignorehitpause=1

[state ]
type=lifeadd
trigger1=!ishelper
trigger1=((helper(99004),var(11))&65535)>0
value=-ifelse(life<=lifemax/4,ifelse(((helper(99004),var(11))&65535)>1,((helper(99004),var(11))&65535)/2,1),((helper(99004),var(11))&65535))
kill=1
absolute=1
ignorehitpause=1

[state ]
type=lifeadd
trigger1=!ishelper
trigger1=alive
trigger1=life<lifemax
trigger1=((helper(99004),var(11))&65535)=0
value=1
kill=0
absolute=1
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
trigger1=!ishelper(99003)
trigger1=!ishelper(99002)
trigger1=!ishelper(99001)
trigger1=!ishelper(99004)
value=5150
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
value=99000
ignorehitpause=1

;; ScreenBound同期

[state ]
type=screenbound
trigger1=!ishelper
value=ifelse((helper(99004),var(8))=1,0,1)
movecamera=ifelse((helper(99004),var(8))=1,0,1),ifelse((helper(99004),var(8))=1,0,1)
ignorehitpause=1

;; 変数更新とデバッグ表示

;; Body AngleDraw適用

[state ]
type=angledraw
trigger1=!ishelper
value=0
scale=1,1
ignorehitpause=1

[state ]
type=angledraw
trigger1=!ishelper
trigger1=((helper(99004),var(22))&64)!=0
value=(helper(99004),fvar(7))
scale=(helper(99004),fvar(5)),(helper(99004),fvar(6))
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
trigger1=!var(0)
var(0)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=!ishelper
var(0)=1
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
fvar(0)=asin(sin(var(0)*pi/48))*2/pi
ignorehitpause=1

[state ]
type=displaytoclipboard
trigger1=!ishelper
text="time: %d\npos y: %f"
params=time,pos y
ignorehitpause=1

;; 地面隣接浮遊時の足元波紋

[state ]
type=helper
triggerall=!ishelper
triggerall=pos y>=-20
triggerall=abs(vel x)<1
trigger1=!(var(0)%24)
name="ground_floating_ripple_left"
id=500020
stateno=500020
helpertype=normal
postype=p1
pos=0,-pos y+26
facing=1
keyctrl=0
ownpal=1
pausemovetime=99990000000
supermovetime=99990000000
ignorehitpause=1

[state ]
type=helper
triggerall=!ishelper
triggerall=pos y>=-20
triggerall=abs(vel x)<1
trigger1=!(var(0)%24)
name="ground_floating_ripple_right"
id=500021
stateno=500021
helpertype=normal
postype=p1
pos=0,-pos y+26
facing=1
keyctrl=0
ownpal=1
pausemovetime=99990000000
supermovetime=99990000000
ignorehitpause=1

