trigger1=!ishelper
trigger1=!numhelper(99003)
trigger1=numhelper(99001)
name="the_head_aura"
id=99003
stateno=99003
anim=99001
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

;; オーラヘルパー生成

[state ]
type=helper
trigger1=!ishelper
trigger1=!numhelper(99002)
name="the_aura"
id=99002
stateno=99002
anim=0
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

;; 本体透過

[state ]
type=trans
trigger1=!ishelper
trans=addalpha
alpha=128,128
ignorehitpause=1

;; 本体残像

[state ]
type=afterimage
trigger1=!ishelper
trigger1=!var(10)
trigger1=var(10):=1||1
trigger3=!ishelper
trigger3=!(var(0)%600)
time=-1
length=48
trans=add
palcolor=128
palbright=15,15,45
palcontrast=88,88,188
palpostbright=0,0,0
paladd=0,0,0
palmul=0.6,0.6,0.8
ignorehitpause=1
