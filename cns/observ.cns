[statedef -2]

[state ]
type=selfstate
trigger1=ishelper
trigger1=!ishelper(99003)
trigger1=!ishelper(99002)
trigger1=!ishelper(99001)
trigger1=!ishelper(99004)
value=5150
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
value=99000
ignorehitpause=1

;; 変数更新とデバッグ表示

[state ]
type=varset
trigger1=!ishelper
trigger1=!var(0)
var(0)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=!ishelper
var(0)=1
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
fvar(0)=asin(sin(var(0)*pi/48))*2/pi
ignorehitpause=1

[state ]
type=displaytoclipboard
trigger1=!ishelper
text="private-time: %d\npos y: %f"
params=var(1),pos y
ignorehitpause=1

[statedef -3]

;; 浮遊移動と状態変更

[state ]
type=posset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(3)=0
y=0
ignorehitpause=1

[state ]
type=posadd
trigger1=!ishelper
trigger1=var(3)=1
y=-6
ignorehitpause=1

[state ]
type=posadd
trigger1=!ishelper
trigger1=var(3)=1
trigger1=pos y<-90
y=6*((-pos y-90)/90)
ignorehitpause=1

[state ]
type=posadd
trigger1=!ishelper
trigger1=var(3)=0
trigger1=var(4)=1
trigger1=pos y<0
y=6
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(3)=0
y=0
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=var(3)=1
y=0
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=var(4)=1
y=0
ignorehitpause=1

[state ]
type=veladd
trigger1=!ishelper
trigger1=var(3)=0
trigger1=var(4)=0
trigger1=pos y<-40
trigger1=vel y<1.0
y=const(movement.yaccel)*0.1
ignorehitpause=1

[state ]
type=veladd
trigger1=!ishelper
trigger1=var(3)=0
trigger1=var(4)=0
trigger1=pos y<-90
trigger1=vel y<1.0
y=const(movement.yaccel)*0.1*((-pos y-90)/90)
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=var(3)=0
trigger1=pos y>=-40
trigger1=pos y<0
y=0
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=var(3)=1
statetype=a
physics=n
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y<0
statetype=a
physics=n
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(4)=1
statetype=c
physics=c
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(4)=0
trigger1=var(3)=0
statetype=s
physics=s
ignorehitpause=1

;; 浮遊表示

[state ]
type=offset
trigger1=!ishelper
trigger1=movetype!=h
trigger1=statetype!=c
trigger1=(stateno=0)||(stateno=20)||(stateno=21)||(stateno=[60,61])||(statetype=a)
y=8*(fvar(0)*(0.9+0.1*abs(fvar(0)))+1.6*fvar(0)*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0)))+2
ignorehitpause=1

[state ]
type=offset
trigger1=!ishelper
trigger1=(movetype=h)||(statetype=c)
trigger2=!ishelper
trigger2=(stateno!=0)&&(stateno!=20)&&(stateno!=21)&&(stateno!=[60,61])&&(statetype!=a)
y=0
ignorehitpause=1

;; 頭部ヘルパー生成

