[statedef -2]

;; 変数更新とデバッグ表示

[state ]
type=varset
trigger1=!ishelper
trigger1=!var(0)
var(0)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=!ishelper
var(0)=1
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
fvar(0)=asin(sin(var(0)*pi/48))*2/pi
ignorehitpause=1

[state ]
type=varset
trigger1=!ishelper
trigger1=time=0
var(1)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=!ishelper
var(1)=1
ignorehitpause=1

[state ]
type=displaytoclipboard
trigger1=!ishelper
text="private-time: %d\npos y: %f"
params=var(1),pos y
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
trigger1=!ishelper(99001)
value=5150
ignorehitpause=1

;; 頭部ヘルパー位置

[state ]
type=posset
trigger1=ishelper(99001)
x=root,pos x
y=root,pos y-61
ignorehitpause=1

;; 表示とヘルパー振り分け

[state ]
type=offset
trigger1=ishelper(99001)
trigger1=root,movetype!=h
trigger1=root,statetype!=c
trigger1=(root,stateno=0)||(root,stateno=20)||(root,stateno=21)||(root,stateno=[60,61])||(root,statetype=a)
y=6*((root,fvar(0))*(0.9+0.1*abs(root,fvar(0)))+1.6*(root,fvar(0))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0))))+2
ignorehitpause=1

[state ]
type=offset
trigger1=ishelper(99001)
trigger1=(root,movetype=h)||(root,statetype=c)
trigger2=ishelper(99001)
trigger2=(root,stateno!=0)&&(root,stateno!=20)&&(root,stateno!=21)&&(root,stateno!=[60,61])&&(root,statetype!=a)
y=0
ignorehitpause=1

[state ]
type=trans
trigger1=!ishelper
trigger2=ishelper(99001)
trans=addalpha
alpha=256,55
ignorehitpause=1

[state ]
type=selfstate
trigger1=ishelper
value=99000
ignorehitpause=1

[statedef -3]

;; 浮遊移動と状態変更

[state ]
type=posset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(3)=0
y=0
ignorehitpause=1

[state ]
type=posadd
trigger1=!ishelper
trigger1=var(3)=1
y=-6
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(3)=0
y=0
ignorehitpause=1

[state ]
type=velset
trigger1=!ishelper
trigger1=var(3)=1
y=0
ignorehitpause=1

[state ]
type=veladd
trigger1=!ishelper
trigger1=var(3)=0
trigger1=pos y<=-40
y=const(movement.yaccel)*0.1
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=var(3)=1
statetype=a
physics=n
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y<0
statetype=a
physics=n
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(4)=1
statetype=c
physics=c
ignorehitpause=1

[state ]
type=statetypeset
trigger1=!ishelper
trigger1=pos y>=0
trigger1=var(4)=0
trigger1=var(3)=0
statetype=s
physics=s
ignorehitpause=1

;; 浮遊表示

[state ]
type=offset
trigger1=!ishelper
trigger1=movetype!=h
trigger1=statetype!=c
trigger1=(stateno=0)||(stateno=20)||(stateno=21)||(stateno=[60,61])||(statetype=a)
y=8*(fvar(0)*(0.9+0.1*abs(fvar(0)))+1.6*fvar(0)*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0))*(1-fvar(0)*fvar(0)))+2
ignorehitpause=1

[state ]
type=offset
trigger1=!ishelper
trigger1=(movetype=h)||(statetype=c)
trigger2=!ishelper
trigger2=(stateno!=0)&&(stateno!=20)&&(stateno!=21)&&(stateno!=[60,61])&&(statetype!=a)
y=0
ignorehitpause=1

;; 頭部ヘルパー生成

[state ]
type=helper
trigger1=!ishelper
trigger1=!numhelper(99001)
name="the_head"
id=99001
anim=99001
helpertype=player
ignorehitpause=1
pausemovetime=99990000000
supermovetime=99990000000

;; 不可視化

[state ]
type=assertspecial
trigger1=ishelper(99001)
trigger1=root,stateno=[100,107]
flag=invisible

[state ]
type=afterimage
trigger1=!ishelper
trigger1=!var(10)
trigger1=var(10):=1||1
trigger2=ishelper(99001)
trigger2=!var(10)
trigger2=var(10):=1||1
trigger3=!ishelper
trigger3=!(var(0)%600)
trigger4=ishelper(99001)
trigger4=!(root,var(0)%600)
time=-1
length=64
trans=add
palcolor=128
palbright=15,15,45
palcontrast=88,88,188
palpostbright=0,0,0
paladd=0,0,0
palmul=1.1,1.1,1.1
ignorehitpause=1
