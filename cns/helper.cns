[statedef 99004]
type=s
movetype=i
physics=n
anim=99004

;; Helper Armorダメージ取得

[state ]
type=varset
trigger1=gethitvar(damage)>0
trigger1=var(12)=0
var(11)=gethitvar(damage)
ignorehitpause=1

[state ]
type=varset
trigger1=gethitvar(damage)>0
trigger1=var(12)=0
var(12)=gethitvar(damage)
ignorehitpause=1

[state ]
type=assertspecial
trigger1=1
flag=invisible
ignorehitpause=1

[state ]
type=parentvarset
trigger1=root,time=1
var(1)=0
ignorehitpause=1

[state ]
type=parentvaradd
trigger1=root,time!=1
var(1)=1
ignorehitpause=1

;; オーラバウンド監視

[state ]
type=changestate
trigger1=(root,stateno=4001)||(root,stateno=4002)||(root,stateno=4003)
trigger1=root,var(1)=0
trigger1=var(0)=0
value=99101+(root,stateno=4002)+(root,stateno=4003)*2
ignorehitpause=1

;; オーラバウンド共通消費

[state ]
type=varset
trigger1=var(0)=1
trigger1=fvar(1)<=0
fvar(0)=0
ignorehitpause=1

[state ]
type=varadd
trigger1=var(0)=1
trigger1=var(1)>0
var(1)=-1
ignorehitpause=1

[state ]
type=varadd
trigger1=var(0)=1
trigger1=var(1)<=0
trigger1=fvar(1)>0
fvar(0)=-fvar(1)
ignorehitpause=1

[state ]
type=varset
trigger1=var(0)=1
trigger1=fvar(1)<=0
fvar(0)=0
ignorehitpause=1

[state ]
type=varset
trigger1=var(0)=1
trigger1=fvar(0)<=0
fvar(0)=0
ignorehitpause=1

[state ]
type=varset
trigger1=var(0)=1
trigger1=fvar(0)<=0
var(0)=0
ignorehitpause=1

