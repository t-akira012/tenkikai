;; Root位置追従

[state ]
type=posset
trigger1=1
x=root,pos x
y=root,pos y
ignorehitpause=1

;; Root向き同期

[state ]
type=turn
trigger1=facing!=root,facing
ignorehitpause=1

;; Rootアニメーション同期

[state ]
type=changeanim
trigger1=anim!=root,anim
value=root,anim
elem=root,animelemno(0)
ignorehitpause=1

;; Aura倍率・傾斜同期

[state ]
type=angledraw
trigger1=1
value=0
scale=1.075+0.075*(root,fvar(0))+(helper(99004),fvar(0)),1.075+0.075*(root,fvar(0))+(helper(99004),fvar(0))
ignorehitpause=1

[state ]
type=angledraw
trigger1=helper(99004),var(0)=0
trigger1=helper(99004),var(20)=1
value=(helper(99004),fvar(7))
scale=(helper(99004),fvar(5)),(helper(99004),fvar(6))
ignorehitpause=1

;; Aura浮遊オフセット

[state ]
type=offset
trigger1=root,movetype!=h
trigger1=root,statetype!=c
trigger1=(root,stateno=0)||(root,stateno=20)||(root,stateno=21)||(root,stateno=[60,61])||(root,statetype=a)
y=8*((root,fvar(0))*(0.9+0.1*abs(root,fvar(0)))+1.6*(root,fvar(0))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0))))+2
ignorehitpause=1

[state ]
type=offset
trigger1=(root,movetype=h)||(root,statetype=c)
trigger2=(root,stateno!=0)&&(root,stateno!=20)&&(root,stateno!=21)&&(root,stateno!=[60,61])&&(root,statetype!=a)
y=0
ignorehitpause=1

[state ]
type=offset
trigger1=helper(99004),var(0)=0
trigger1=helper(99004),var(20)=1
y=(helper(99004),fvar(8))
ignorehitpause=1

