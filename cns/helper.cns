ignorehitpause=1

[state ]
type=afterimage
triggerall=((helper(99004),var(22))&4)=0
trigger1=!var(10)
trigger1=var(10):=1||1
trigger2=!(root,var(0)%600)
time=-1
length=48
trans=add
