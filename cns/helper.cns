;; 常駐Helper最終処理

[statedef 99199]

[state ]
type=selfstate
trigger1=1
value=5150
ignorehitpause=1

[statedef 99001]
anim=99001

;; 画面外移動許可

[state ]
type=screenbound
trigger1=1
value=0
movecamera=0,0
ignorehitpause=1

[state ]
type=posset
trigger1=1
x=root,pos x
y=root,pos y-61
ignorehitpause=1

;; 前後ダッシュ頭部位置移動

[state ]
type=posadd
trigger1=root,stateno=110
x=55
y=26
ignorehitpause=1

[state ]
type=posadd
trigger1=root,stateno=111
x=-35
y=6
ignorehitpause=1

[state ]
type=turn
trigger1=facing!=root,facing

[state ]
type=offset
trigger1=root,movetype!=h
trigger1=root,statetype!=c
trigger1=(root,stateno=0)||(root,stateno=20)||(root,stateno=21)||(root,stateno=[60,61])||(root,statetype=a)
x=0
y=6*((root,fvar(0))*(0.9+0.1*abs(root,fvar(0)))+1.6*(root,fvar(0))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0))))+2
ignorehitpause=1

[state ]
type=offset
trigger1=(root,movetype=h)||(root,statetype=c)
trigger2=(root,stateno!=0)&&(root,stateno!=20)&&(root,stateno!=21)&&(root,stateno!=[60,61])&&(root,statetype!=a)
x=0
y=0
ignorehitpause=1

[state ]
type=trans
trigger1=1
trans=addalpha
alpha=128,128
ignorehitpause=1

[state ]
type=assertspecial
trigger1=root,stateno=[100,107]
flag=invisible

[state ]
type=afterimage
trigger1=!var(10)
trigger1=var(10):=1||1
trigger2=!(root,var(0)%600)
time=-1
length=48
trans=add
palcolor=128
palbright=15,15,45
palcontrast=88,88,188
palpostbright=0,0,0
paladd=0,0,0
palmul=0.6,0.6,0.8
ignorehitpause=1

[state ]
type=null
trigger1=1

[statedef 99002]

;; Root位置追従

[state ]
type=posset
trigger1=1
x=root,pos x
y=root,pos y
ignorehitpause=1

;; Root向き同期

[state ]
type=turn
trigger1=facing!=root,facing
ignorehitpause=1

;; Rootアニメーション同期

[state ]
type=changeanim
trigger1=anim!=root,anim
value=root,anim
elem=root,animelemno(0)
ignorehitpause=1

;; Aura倍率・傾斜同期

[state ]
type=angledraw
trigger1=1
value=-56.16*(root,stateno=110)*(root,var(5)!=0)+30*(root,stateno=111)*(root,var(5)!=0)
scale=1.075+0.075*(root,fvar(0))+(helper(99004),fvar(0)),1.075+0.075*(root,fvar(0))+(helper(99004),fvar(0))
ignorehitpause=1

;; Aura浮遊オフセット

[state ]
type=offset
trigger1=root,movetype!=h
trigger1=root,statetype!=c
trigger1=(root,stateno=0)||(root,stateno=20)||(root,stateno=21)||(root,stateno=[60,61])||(root,statetype=a)
y=8*((root,fvar(0))*(0.9+0.1*abs(root,fvar(0)))+1.6*(root,fvar(0))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0)))*(1-(root,fvar(0))*(root,fvar(0))))+2
ignorehitpause=1

[state ]
type=offset
trigger1=(root,movetype=h)||(root,statetype=c)
trigger2=(root,stateno!=0)&&(root,stateno!=20)&&(root,stateno!=21)&&(root,stateno!=[60,61])&&(root,statetype!=a)
y=0
ignorehitpause=1

;; Aura透過表示

[state ]
type=trans
trigger1=1
trans=addalpha
alpha=128,256
ignorehitpause=1

;; Aura残像

[state ]
type=afterimage
trigger1=!var(10)
trigger1=var(10):=1||1
time=-1
length=128
trans=add
palcolor=128
palbright=15,15,45
palcontrast=88,88,188
palpostbright=0,0,0
paladd=0,0,0
palmul=0.2,0.2,0.8
mul=0.1,0.4,0.4
ignorehitpause=1

