[statedef 300]
type=a
movetype=I
physics=N
ctrl=0
anim=300
velset=0,0

;; 出現領域入力初期化

[state ]
type=varset
trigger1=!time
var(6)=0

[state ]
type=varset
trigger1=!time
var(7)=0

[state ]
type=varset
trigger1=time>0
trigger1=(var(2)&1008)=0
var(7)=1

;; 回転中の前後移動

[state ]
type=posadd
trigger1=(var(2)&1)!=0
trigger1=(var(2)&2)=0
x=6

[state ]
type=posadd
trigger1=(var(2)&2)!=0
x=-4

[state ]
type=posadd
trigger1=(var(2)&1)=0
trigger1=(var(2)&2)=0
x=-2

;; 出現領域選択

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&16)!=0
var(6)=1

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&32)!=0
var(6)=2

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&64)!=0
var(6)=3

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&128)!=0
var(6)=4

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&256)!=0
var(6)=5

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&512)!=0
var(6)=6

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&1008)!=0
var(7)=0

[state ]
type=changestate
trigger1=animtime=0
value=301

;-------------------------------------------------

[statedef 301]
type=a
movetype=I
physics=N
ctrl=0
anim=301
velset=0,0

;; 未選択時の敵背後移動

[state ]
type=posadd
trigger1=var(6)=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*25<0
x=(300-screenpos x)*facing

[state ]
type=posadd
trigger1=var(6)=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*25>320
x=(20-screenpos x)*facing

[state ]
type=posadd
trigger1=var(6)=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*25>=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*25<=320
x=((enemynear,screenpos x)-(enemynear,facing)*25-screenpos x)*facing

;; 出現列移動

[state ]
type=posadd
trigger1=(var(6)=1)||(var(6)=4)
x=(53-screenpos x)*facing

[state ]
type=posadd
trigger1=(var(6)=2)||(var(6)=5)
x=(160-screenpos x)*facing

[state ]
type=posadd
trigger1=(var(6)=3)||(var(6)=6)
x=(267-screenpos x)*facing

;; 出現段移動

[state ]
type=posset
trigger1=var(6)=[1,3]
y=-60

[state ]
type=posset
trigger1=var(6)=[4,6]
y=-180

;; 残像消去

[state ]
type=afterimagetime
trigger1=1
time=0

[state ]
type=changestate
trigger1=time>=8
value=302

