[statedef 300]
type=a
movetype=I
physics=N
ctrl=0
anim=300

;; 出現領域入力初期化

[state ]
type=varset
trigger1=!time
var(6)=0

[state ]
type=varset
trigger1=!time
var(7)=0

[state ]
type=varset
trigger1=time>0
trigger1=(var(2)&1008)=0
var(7)=1

;; 回転中の前後移動

[state ]
type=varset
trigger1=((var(2)&1)!=0)&&((var(2)&2)=0)
var(8)=var(0)+2

[state ]
type=varset
trigger1=((var(2)&1)!=0)&&((var(2)&2)=0)
fvar(1)=6

[state ]
type=varset
trigger1=((var(2)&1)!=0)&&((var(2)&2)=0)
fvar(2)=1.5

[state ]
type=varset
trigger1=(var(2)&2)!=0
var(8)=var(0)+2

[state ]
type=varset
trigger1=(var(2)&2)!=0
fvar(1)=-4

[state ]
type=varset
trigger1=(var(2)&2)!=0
fvar(2)=1

[state ]
type=varset
trigger1=(var(2)&1)=0
trigger1=(var(2)&2)=0
var(8)=var(0)+2

[state ]
type=varset
trigger1=(var(2)&1)=0
trigger1=(var(2)&2)=0
fvar(1)=-2

[state ]
type=varset
trigger1=(var(2)&1)=0
trigger1=(var(2)&2)=0
fvar(2)=0.5

;; 回転中の加速上昇

[state ]
type=varset
trigger1=!time
fvar(5)=vel y

[state ]
type=varset
trigger1=!time
fvar(8)=0

[state ]
type=varset
trigger1=1
var(12)=var(0)+2

[state ]
type=varadd
trigger1=(var(2)&4)!=0
trigger1=fvar(5)>ifelse(pos y<-90,-6+6*((-pos y-90)/90),-6)
fvar(5)=-1

[state ]
type=varset
trigger1=(var(2)&4)!=0
trigger1=fvar(5)<ifelse(pos y<-90,-6+6*((-pos y-90)/90),-6)
fvar(5)=ifelse(pos y<-90,-6+6*((-pos y-90)/90),-6)

[state ]
type=varadd
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)!=0
trigger1=fvar(5)<6
fvar(5)=1

[state ]
type=varset
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)!=0
trigger1=fvar(5)>6
fvar(5)=6

[state ]
type=varadd
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)=0
trigger1=pos y<-40
trigger1=fvar(5)<1
fvar(5)=0.044*ifelse(pos y<-90,1+((-pos y-90)/90),1)

[state ]
type=varset
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)=0
trigger1=pos y<-40
trigger1=fvar(5)>1
fvar(5)=1

[state ]
type=varset
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)=0
trigger1=pos y>=-40
trigger1=abs(fvar(5))<=0.166667
fvar(5)=0

[state ]
type=varadd
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)=0
trigger1=pos y>=-40
trigger1=fvar(5)>0.166667
fvar(5)=-0.166667

[state ]
type=varadd
trigger1=(var(2)&4)=0
trigger1=(var(2)&8)=0
trigger1=pos y>=-40
trigger1=fvar(5)<-0.166667
fvar(5)=0.166667

[state ]
type=varset
trigger1=animtime<0
trigger1=(helper(99004),var(15))=anim
trigger1=(helper(99004),var(16))>0
fvar(6)=animelemtime(1)*1.0/(helper(99004),var(16))

[state ]
type=varset
trigger1=animtime<0
trigger1=(helper(99004),var(15))=anim
trigger1=(helper(99004),var(16))>0
fvar(7)=fvar(6)*fvar(6)

[state ]
type=varset
trigger1=animtime<0
trigger1=(helper(99004),var(15))=anim
trigger1=(helper(99004),var(16))>0
fvar(8)=-72.0*fvar(7)*fvar(7)*fvar(6)/(helper(99004),var(16))

[state ]
type=velset
trigger1=animtime<0
trigger1=(helper(99004),var(15))=anim
trigger1=(helper(99004),var(16))>0
y=fvar(5)+fvar(8)

;; 出現領域選択

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&16)!=0
var(6)=1

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&32)!=0
var(6)=2

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&64)!=0
var(6)=3

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&128)!=0
var(6)=4

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&256)!=0
var(6)=5

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&512)!=0
var(6)=6

[state ]
type=varset
trigger1=var(7)=1
trigger1=(var(2)&1008)!=0
var(7)=0

[state ]
type=changestate
trigger1=animtime=0
value=301

;-------------------------------------------------

[statedef 301]
type=a
movetype=I
physics=N
ctrl=0
anim=301
velset=0,0

[state ]
type=varset
trigger1=1
var(11)=var(0)+2

[state ]
type=varset
trigger1=1
var(12)=var(0)+2

[state ]
type=velset
trigger1=1
x=0
y=0

;; 未選択時の敵背後移動

[state ]
type=posadd
trigger1=var(6)=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*50<0
x=(300-screenpos x)*facing

[state ]
type=posadd
trigger1=var(6)=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*50>320
x=(20-screenpos x)*facing

[state ]
type=posadd
trigger1=var(6)=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*50>=0
trigger1=(enemynear,screenpos x)-(enemynear,facing)*50<=320
x=((enemynear,screenpos x)-(enemynear,facing)*50-screenpos x)*facing

;; 出現列移動

[state ]
type=posadd
trigger1=(var(6)=1)||(var(6)=4)
x=(53-screenpos x)*facing

[state ]
type=posadd
trigger1=(var(6)=2)||(var(6)=5)
x=(160-screenpos x)*facing

[state ]
type=posadd
trigger1=(var(6)=3)||(var(6)=6)
x=(267-screenpos x)*facing

;; 出現段移動

[state ]
type=posset
trigger1=var(6)=[1,3]
y=-60

[state ]
type=posset
trigger1=var(6)=[4,6]
y=-90

;; 残像消去

[state ]
type=afterimagetime
trigger1=1
time=0

[state ]
type=changestate
trigger1=time>=8
value=302

